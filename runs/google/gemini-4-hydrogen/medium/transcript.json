        "Content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Vegan Ramen</title>\n  <style>\n    *, *::before, *::after {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0;\n    }\n\n    html, body {\n      width: 100%;\n      height: 100%;\n      overflow: hidden;\n      background-color: #090706;\n      user-select: none;\n      -webkit-user-select: none;\n    }\n\n    .scene {\n      position: relative;\n      width: 100vw;\n      height: 100dvh;\n      display: grid;\n      place-items: center;\n      overflow: hidden;\n      background:\n        radial-gradient(circle at 50% 44%, rgba(168, 86, 30, 0.16) 0%, rgba(92, 40, 14, 0.08) 32%, rgba(14, 10, 8, 0.94) 68%, #070504 100%),\n        linear-gradient(180deg, #100c0a 0%, #090706 100%);\n    }\n\n    /* Subtle charred wood table texture via CSS gradients */\n    .table-surface {\n      position: absolute;\n      inset: -8%;\n      background:\n        repeating-linear-gradient(\n          92deg,\n          rgba(255, 220, 180, 0.012) 0px,\n          rgba(255, 220, 180, 0.012) 2px,\n          transparent 2px,\n          transparent 18px,\n          rgba(0, 0, 0, 0.18) 18px,\n          rgba(0, 0, 0, 0.18) 21px\n        ),\n        radial-gradient(ellipse 68% 54% at 50% 48%, rgba(120, 62, 24, 0.22) 0%, rgba(45, 24, 12, 0.14) 45%, rgba(8, 6, 5, 0.85) 85%);\n      pointer-events: none;\n      transform: translate3d(var(--bg-x, 0px), var(--bg-y, 0px), 0);\n      will-change: transform;\n    }\n\n    /* Ambient warm lantern glow that responds subtly to cursor */\n    .ambient-glow {\n      position: absolute;\n      width: min(95vw, 95vh);\n      height: min(95vw, 95vh);\n      border-radius: 50%;\n      background: radial-gradient(\n        circle at 50% 50%,\n        rgba(245, 152, 66, 0.14) 0%,\n        rgba(212, 92, 28, 0.07) 38%,\n        rgba(120, 42, 12, 0.02) 64%,\n        transparent 75%\n      );\n      filter: blur(18px);\n      pointer-events: none;\n      transform: translate3d(var(--glow-x, 0px), var(--glow-y, 0px), 0);\n      will-change: transform;\n    }\n\n    /* Background atmospheric dust/ember motes canvas */\n    #ambient-canvas {\n      position: absolute;\n      inset: 0;\n      width: 100%;\n      height: 100%;\n      pointer-events: none;\n      z-index: 1;\n    }\n\n    /* Hero bowl container */\n    .bowl-stage {\n      position: relative;\n      z-index: 2;\n      width: min(86vw, 86vh, 720px);\n      height: min(86vw, 86vh, 720px);\n      display: grid;\n      place-items: center;\n      transform: translate3d(var(--bowl-x, 0px), var(--bowl-y, 0px), 0)\n                 rotateX(var(--tilt-x, 0deg))\n                 rotateY(var(--tilt-y, 0deg));\n      transform-style: preserve-3d;\n      will-change: transform;\n    }\n\n    .ramen-svg {\n      width: 100%;\n      height: 100%;\n      overflow: visible;\n      filter: drop-shadow(0 36px 48px rgba(0, 0, 0, 0.85));\n    }\n\n    /* Steam and interactive broth-ripple canvas layered over the bowl */\n    #steam-canvas {\n      position: absolute;\n      inset: 0;\n      width: 100%;\n      height: 100%;\n      pointer-events: none;\n      z-index: 3;\n    }\n\n    /* Subtle organic animations for broth & toppings */\n    @keyframes brothBreath {\n      0%, 100% { transform: scale(1) translateY(0px); opacity: 0.85; }\n      50% { transform: scale(1.012) translateY(-0.6px); opacity: 1; }\n    }\n\n    @keyframes floatSlow {\n      0%, 100% { transform: translate3d(0px, 0px, 0) rotate(0deg); }\n      50% { transform: translate3d(0.8px, -1.6px, 0) rotate(0.45deg); }\n    }\n\n    @keyframes floatSlowAlt {\n      0%, 100% { transform: translate3d(0px, 0px, 0) rotate(0deg); }\n      50% { transform: translate3d(-1px, -1.3px, 0) rotate(-0.5deg); }\n    }\n\n    @keyframes oilShimmer {\n      0%, 100% { opacity: 0.72; transform: scale(1); }\n      50% { opacity: 0.96; transform: scale(1.06); }\n    }\n\n    .broth-shimmer {\n      transform-origin: 400px 395px;\n      animation: brothBreath 6.5s ease-in-out infinite;\n    }\n\n    .topping-float-a {\n      transform-box: fill-box;\n      transform-origin: center;\n      animation: floatSlow 5.8s ease-in-out infinite;\n    }\n\n    .topping-float-b {\n      transform-box: fill-box;\n      transform-origin: center;\n      animation: floatSlowAlt 6.4s ease-in-out infinite;\n    }\n\n    .topping-float-c {\n      transform-box: fill-box;\n      transform-origin: center;\n      animation: floatSlow 7.2s ease-in-out -2.1s infinite;\n    }\n\n    .oil-drop {\n      transform-box: fill-box;\n      transform-origin: center;\n      animation: oilShimmer 4.8s ease-in-out infinite;\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n      .broth-shimmer,\n      .topping-float-a,\n      .topping-float-b,\n      .topping-float-c,\n      .oil-drop {\n        animation: none !important;\n      }\n      .table-surface,\n      .ambient-glow,\n      .bowl-stage {\n        transform: none !important;\n      }\n    }\n  </style>\n</head>\n<body>\n  <main class=\"scene\" id=\"scene\" aria-label=\"Steaming bowl of vegan ramen\">\n    <div class=\"table-surface\"></div>\n    <div class=\"ambient-glow\"></div>\n    <canvas id=\"ambient-canvas\"></canvas>\n\n    <div class=\"bowl-stage\" id=\"bowl-stage\">\n      <svg class=\"ramen-svg\" viewBox=\"0 0 800 800\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-hidden=\"true\">\n        <defs>\n          <!-- Table contact shadow & warm bounce -->\n          <radialGradient id=\"bowlContactShadow\" cx=\"50%\" cy=\"54%\" r=\"50%\">\n            <stop offset=\"0%\" stop-color=\"#000000\" stop-opacity=\"0.92\" />\n            <stop offset=\"58%\" stop-color=\"#050302\" stop-opacity=\"0.72\" />\n            <stop offset=\"82%\" stop-color=\"#1a0b04\" stop-opacity=\"0.28\" />\n            <stop offset=\"100%\" stop-color=\"#000000\" stop-opacity=\"0\" />\n          </radialGradient>\n\n          <!-- Artisanal ceramic outer glaze -->\n          <linearGradient id=\"ceramicOuter\" x1=\"18%\" y1=\"10%\" x2=\"82%\" y2=\"95%\">\n            <stop offset=\"0%\" stop-color=\"#2c2623\" />\n            <stop offset=\"32%\" stop-color=\"#1b1715\" />\n            <stop offset=\"72%\" stop-color=\"#110e0d\" />\n            <stop offset=\"100%\" stop-color=\"#090706\" />\n          </linearGradient>\n\n          <!-- Warm kiln-fired rim glaze -->\n          <linearGradient id=\"ceramicRim\" x1=\"15%\" y1=\"5%\" x2=\"85%\" y2=\"95%\">\n            <stop offset=\"0%\" stop-color=\"#b86b3a\" />\n            <stop offset=\"22%\" stop-color=\"#7c4222\" />\n            <stop offset=\"52%\" stop-color=\"#3a2921\" />\n            <stop offset=\"82%\" stop-color=\"#69391f\" />\n            <stop offset=\"100%\" stop-color=\"#241c18\" />\n          </linearGradient>\n\n          <!-- Inner ceramic wall shadow -->\n          <radialGradient id=\"innerWallGrad\" cx=\"46%\" cy=\"42%\" r=\"54%\">\n            <stop offset=\"68%\" stop-color=\"#14100e\" />\n            <stop offset=\"88%\" stop-color=\"#251d19\" />\n            <stop offset=\"96%\" stop-color=\"#3d2b22\" />\n            <stop offset=\"100%\" stop-color=\"#1c1512\" />\n          </radialGradient>\n\n          <!-- Rich vegan miso-sesame-shoyu broth -->\n          <radialGradient id=\"brothBase\" cx=\"46%\" cy=\"44%\" r=\"52%\">\n            <stop offset=\"0%\" stop-color=\"#e59b3e\" />\n            <stop offset=\"28%\" stop-color=\"#c96b22\" />\n            <stop offset=\"62%\" stop-color=\"#8c3b11\" />\n            <stop offset=\"88%\" stop-color=\"#521d08\" />\n            <stop offset=\"100%\" stop-color=\"#2b0d03\" />\n          </radialGradient>\n\n          <!-- Broth warm overhead sheen -->\n          <radialGradient id=\"brothSheen\" cx=\"38%\" cy=\"34%\" r=\"48%\">\n            <stop offset=\"0%\" stop-color=\"#ffd58a\" stop-opacity=\"0.42\" />\n            <stop offset=\"38%\" stop-color=\"#f29b42\" stop-opacity=\"0.16\" />\n            <stop offset=\"100%\" stop-color=\"#8c3b11\" stop-opacity=\"0\" />\n          </radialGradient>\n\n          <!-- Broth depth vignette around rim -->\n          <radialGradient id=\"brothRimDepth\" cx=\"50%\" cy=\"50%\" r=\"50%\">\n            <stop offset=\"72%\" stop-color=\"#000000\" stop-opacity=\"0\" />\n            <stop offset=\"92%\" stop-color=\"#1a0802\" stop-opacity=\"0.52\" />\n            <stop offset=\"100%\" stop-color=\"#0a0301\" stop-opacity=\"0.82\" />\n          </radialGradient>\n\n          <!-- Chili oil (Rayu) droplets -->\n          <radialGradient id=\"chiliOil\" cx=\"35%\" cy=\"35%\" r=\"65%\">\n            <stop offset=\"0%\" stop-color=\"#ff8c42\" stop-opacity=\"0.92\" />\n            <stop offset=\"45%\" stop-color=\"#d63615\" stop-opacity=\"0.88\" />\n            <stop offset=\"85%\" stop-color=\"#8a1806\" stop-opacity=\"0.85\" />\n            <stop offset=\"100%\" stop-color=\"#590d02\" stop-opacity=\"0\" />\n          </radialGradient>\n\n          <!-- Golden sesame oil droplets -->\n          <radialGradient id=\"sesameOil\" cx=\"35%\" cy=\"35%\" r=\"65%\">\n            <stop offset=\"0%\" stop-color=\"#ffe299\" stop-opacity=\"0.85\" />\n            <stop offset=\"55%\" stop-color=\"#d98c2b\" stop-opacity=\"0.7\" />\n            <stop offset=\"100%\" stop-color=\"#8a4c0f\" stop-opacity=\"0\" />\n          </radialGradient>\n\n          <!-- Noodle gradient -->\n          <linearGradient id=\"noodleGrad\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\n            <stop offset=\"0%\" stop-color=\"#fae096\" />\n            <stop offset=\"50%\" stop-color=\"#e5b85b\" />\n            <stop offset=\"100%\" stop-color=\"#bd862d\" />\n          </linearGradient>\n\n          <!-- Seared Tofu -->\n          <linearGradient id=\"tofuBody\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\n            <stop offset=\"0%\" stop-color=\"#f7ebd2\" />\n            <stop offset=\"65%\" stop-color=\"#ebd4aa\" />\n            <stop offset=\"100%\" stop-color=\"#cfa972\" />\n          </linearGradient>\n          <linearGradient id=\"tofuCrust\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"85%\">\n            <stop offset=\"0%\" stop-color=\"#d97b29\" />\n            <stop offset=\"50%\" stop-color=\"#9e4713\" />\n            <stop offset=\"100%\" stop-color=\"#612507\" />\n          </linearGradient>\n\n          <!-- Shiitake Mushroom -->\n          <radialGradient id=\"shiitakeCap\" cx=\"42%\" cy=\"38%\" r=\"60%\">\n            <stop offset=\"0%\" stop-color=\"#7a4c32\" />\n            <stop offset=\"55%\" stop-color=\"#4d2c1b\" />\n            <stop offset=\"100%\" stop-color=\"#29150b\" />\n          </radialGradient>\n\n          <!-- Bok Choy -->\n          <linearGradient id=\"bokChoyLeaf\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\n            <stop offset=\"0%\" stop-color=\"#6bbd6e\" />\n            <stop offset=\"50%\" stop-color=\"#357d44\" />\n            <stop offset=\"100%\" stop-color=\"#1b4a26\" />\n          </linearGradient>\n          <linearGradient id=\"bokChoyStem\" x1=\"0%\" y1=\"0%\" x2=\"80%\" y2=\"100%\">\n            <stop offset=\"0%\" stop-color=\"#edf5dc\" />\n            <stop offset=\"65%\" stop-color=\"#c3dba8\" />\n            <stop offset=\"100%\" stop-color=\"#8ab573\" />\n          </linearGradient>\n\n          <!-- Nori Seaweed -->\n          <linearGradient id=\"noriGrad\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\n            <stop offset=\"0%\" stop-color=\"#223022\" />\n            <stop offset=\"50%\" stop-color=\"#141e15\" />\n            <stop offset=\"100%\" stop-color=\"#0b110c\" />\n          </linearGradient>\n\n          <!-- Menma (Bamboo Shoots) -->\n          <linearGradient id=\"menmaGrad\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"90%\">\n            <stop offset=\"0%\" stop-color=\"#e3ad59\" />\n            <stop offset=\"55%\" stop-color=\"#b87627\" />\n            <stop offset=\"100%\" stop-color=\"#784611\" />\n          </linearGradient>\n\n          <!-- Chopsticks Dark Walnut -->\n          <linearGradient id=\"chopstickGrad\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\n            <stop offset=\"0%\" stop-color=\"#5c3824\" />\n            <stop offset=\"45%\" stop-color=\"#331d12\" />\n            <stop offset=\"100%\" stop-color=\"#1a0d07\" />\n          </linearGradient>\n\n          <!-- Soft drop shadow filter for toppings -->\n          <filter id=\"softShadow\" x=\"-20%\" y=\"-20%\" width=\"140%\" height=\"140%\">\n            <feDropShadow dx=\"2\" dy=\"6\" stdDeviation=\"5\" flood-color=\"#1a0702\" flood-opacity=\"0.62\" />\n          </filter>\n\n          <!-- Subtle ceramic speckle noise -->\n          <filter id=\"ceramicGrain\" x=\"0%\" y=\"0%\" width=\"100%\" height=\"100%\">\n            <feTurbulence type=\"fractalNoise\" baseFrequency=\"0.65\" numOctaves=\"3\" result=\"noise\" />\n            <feColorMatrix type=\"matrix\" values=\"0 0 0 0 0.8  0 0 0 0 0.55  0 0 0 0 0.35  0 0 0 0.06 0\" in=\"noise\" result=\"coloredNoise\" />\n            <feComposite operator=\"in\" in2=\"SourceGraphic\" />\n          </filter>\n\n          <!-- Clip path for the broth surface -->\n          <ellipse id=\"brothClipShape\" cx=\"400\" cy=\"396\" rx=\"242\" ry=\"222\" />\n          <clipPath id=\"brothClip\">\n            <use href=\"#brothClipShape\" />\n          </clipPath>\n        </defs>\n\n        <!-- Ground contact shadow beneath the bowl -->\n        <ellipse cx=\"405\" cy=\"438\" rx=\"315\" ry=\"275\" fill=\"url(#bowlContactShadow)\" />\n\n        <!-- Subtle warm reflected light on the table right below the bowl rim -->\n        <ellipse cx=\"385\" cy=\"415\" rx=\"285\" ry=\"255\" fill=\"none\" stroke=\"rgba(214, 118, 48, 0.10)\" stroke-width=\"18\" />\n\n        <!-- Outer ceramic bowl body (3/4 overhead perspective) -->\n        <path d=\"M 134 396 C 134 558, 244 654, 400 654 C 556 654, 666 558, 666 396 Z\" fill=\"url(#ceramicOuter)\" />\n        <!-- Bowl foot ring shadow -->\n        <ellipse cx=\"400\" cy=\"642\" rx=\"115\" ry=\"24\" fill=\"#050403\" opacity=\"0.85\" />\n\n        <!-- Bowl outer rim -->\n        <ellipse cx=\"400\" cy=\"392\" rx=\"268\" ry=\"246\" fill=\"url(#ceramicRim)\" />\n        <!-- Rim specular highlight (top-left warm light) -->\n        <path d=\"M 162 290 A 262 240 0 0 1 560 198\" fill=\"none\" stroke=\"rgba(255, 206, 158, 0.28)\" stroke-width=\"5\" stroke-linecap=\"round\" />\n\n        <!-- Inner ceramic wall -->\n        <ellipse cx=\"400\" cy=\"395\" rx=\"252\" ry=\"230\" fill=\"url(#innerWallGrad)\" />\n\n        <!-- BROTH LAYER (clipped to inner bowl) -->\n        <g clip-path=\"url(#brothClip)\">\n          <rect x=\"140\" y=\"150\" width=\"520\" height=\"500\" fill=\"url(#brothBase)\" />\n\n          <!-- Subtle swirling broth currents -->\n          <g class=\"broth-shimmer\">\n            <ellipse cx=\"382\" cy=\"378\" rx=\"190\" ry=\"165\" fill=\"url(#brothSheen)\" />\n            <path d=\"M 240 340 Q 350 280, 470 330 T 580 390\" fill=\"none\" stroke=\"rgba(255, 205, 130, 0.14)\" stroke-width=\"18\" stroke-linecap=\"round\" />\n            <path d=\"M 210 440 Q 330 490, 450 450 T 560 470\" fill=\"none\" stroke=\"rgba(235, 140, 52, 0.11)\" stroke-width=\"14\" stroke-linecap=\"round\" />\n          </g>\n\n          <!-- Submerged noodle mass (softly tinted by broth) -->\n          <g opacity=\"0.58\" stroke=\"#c98532\" stroke-width=\"9\" stroke-linecap=\"round\" fill=\"none\">\n            <path d=\"M 235 415 C 265 375, 325 365, 365 405 C 405 445, 455 440, 495 395\" />\n            <path d=\"M 250 445 C 295 405, 355 425, 395 465 C 435 505, 495 475, 530 435\" />\n            <path d=\"M 275 485 C 315 445, 380 460, 425 495 C 470 530, 525 500, 545 465\" />\n            <path d=\"M 215 385 C 255 345, 310 345, 345 380\" />\n            <path d=\"M 310 515 C 365 485, 430 510, 475 535\" />\n          </g>\n\n          <!-- Top-layer glistening ramen noodles peeking above broth -->\n          <g filter=\"url(#softShadow)\" stroke-linecap=\"round\" fill=\"none\">\n            <!-- Noodle strand cluster -->\n            <path d=\"M 255 428 C 282 396, 328 398, 356 426 C 384 454, 428 452, 462 424\" stroke=\"url(#noodleGrad)\" stroke-width=\"8.5\" />\n            <path d=\"M 244 452 C 282 416, 336 424, 372 456 C 408 488, 462 482, 498 446\" stroke=\"url(#noodleGrad)\" stroke-width=\"9\" />\n            <path d=\"M 268 474 C 304 440, 358 446, 394 478 C 430 510, 478 504, 514 470\" stroke=\"url(#noodleGrad)\" stroke-width=\"8.5\" />\n            <path d=\"M 294 494 C 330 462, 382 468, 418 498 C 454 528, 496 520, 524 492\" stroke=\"#e8ba61\" stroke-width=\"8\" />\n            <path d=\"M 232 412 C 266 376, 316 380, 348 408\" stroke=\"#f5d98e\" stroke-width=\"7.5\" />\n            <path d=\"M 326 410 C 362 384, 408 392, 438 420\" stroke=\"#f5d98e\" stroke-width=\"7.5\" />\n            <!-- Glossy highlights on noodles -->\n            <path d=\"M 284 410 C 312 400, 338 406, 354 422\" stroke=\"rgba(255, 248, 220, 0.55)\" stroke-width=\"2.2\" />\n            <path d=\"M 286 436 C 322 426, 352 436, 374 456\" stroke=\"rgba(255, 248, 220, 0.5)\" stroke-width=\"2.2\" />\n            <path d=\"M 308 462 C 344 452, 374 462, 396 480\" stroke=\"rgba(255, 248, 220, 0.48)\" stroke-width=\"2\" />\n          </g>\n\n          <!-- Floating Chili Oil (Rayu) & Sesame Oil Droplets -->\n          <g class=\"oil-drop\">\n            <circle cx=\"236\" cy=\"336\" r=\"14\" fill=\"url(#chiliOil)\" />\n            <circle cx=\"232\" cy=\"332\" r=\"3\" fill=\"rgba(255, 235, 200, 0.65)\" />\n\n            <circle cx=\"212\" cy=\"368\" r=\"8\" fill=\"url(#chiliOil)\" />\n            <circle cx=\"258\" cy=\"312\" r=\"6\" fill=\"url(#sesameOil)\" />\n            <circle cx=\"524\" cy=\"318\" r=\"11\" fill=\"url(#chiliOil)\" />\n            <circle cx=\"521\" cy=\"314\" r=\"2.2\" fill=\"rgba(255, 235, 200, 0.6)\" />\n\n            <circle cx=\"556\" cy=\"352\" r=\"7\" fill=\"url(#sesameOil)\" />\n            <circle cx=\"542\" cy=\"488\" r=\"12\" fill=\"url(#chiliOil)\" />\n            <circle cx=\"539\" cy=\"484\" r=\"2.5\" fill=\"rgba(255, 235, 200, 0.6)\" />\n\n            <circle cx=\"222\" cy=\"488\" r=\"9.5\" fill=\"url(#chiliOil)\" />\n            <circle cx=\"244\" cy=\"516\" r=\"6.5\" fill=\"url(#sesameOil)\" />\n            <circle cx=\"388\" cy=\"566\" r=\"10.5\" fill=\"url(#chiliOil)\" />\n            <circle cx=\"385\" cy=\"562\" r=\"2.2\" fill=\"rgba(255, 235, 200, 0.55)\" />\n\n            <circle cx=\"445\" cy=\"552\" r=\"6\" fill=\"url(#sesameOil)\" />\n            <circle cx=\"318\" cy=\"242\" r=\"8.5\" fill=\"url(#chiliOil)\" />\n            <circle cx=\"348\" cy=\"228\" r=\"5.5\" fill=\"url(#sesameOil)\" />\n            <circle cx=\"578\" cy=\"412\" r=\"8\" fill=\"url(#chiliOil)\" />\n            <circle cx=\"195\" cy=\"422\" r=\"7\" fill=\"url(#sesameOil)\" />\n          </g>\n\n          <!-- TOPPINGS -->\n\n          <!-- 1. Roasted Nori Seaweed Sheets (tucked along upper-right inner rim) -->\n          <g class=\"topping-float-b\" filter=\"url(#softShadow)\">\n            <path d=\"M 488 214 L 584 268 L 542 346 L 452 292 Z\" fill=\"url(#noriGrad)\" stroke=\"#2b3d2b\" stroke-width=\"1.5\" />\n            <path d=\"M 518 202 L 606 254 L 566 322 L 486 274 Z\" fill=\"url(#noriGrad)\" opacity=\"0.92\" stroke=\"#283828\" stroke-width=\"1.2\" />\n            <!-- Crisp nori texture lines -->\n            <path d=\"M 505 232 L 565 266 M 495 248 L 555 282 M 485 264 L 545 298\" stroke=\"rgba(120, 160, 110, 0.14)\" stroke-width=\"1.2\" />\n          </g>\n\n          <!-- 2. Crisp Blanched Bok Choy (lower-left / left-center) -->\n          <g class=\"topping-float-a\" filter=\"url(#softShadow)\">\n            <!-- Outer leaf 1 -->\n            <path d=\"M 206 382 C 186 342, 208 292, 252 288 C 282 285, 304 314, 294 348 C 284 378, 246 398, 206 382 Z\" fill=\"url(#bokChoyLeaf)\" />\n            <path d=\"M 214 378 C 232 344, 250 318, 266 298\" stroke=\"#9be084\" stroke-width=\"2.5\" stroke-linecap=\"round\" fill=\"none\" opacity=\"0.55\" />\n            <!-- Outer leaf 2 -->\n            <path d=\"M 192 426 C 172 396, 184 352, 224 344 C 258 338, 286 364, 276 398 C 266 428, 222 444, 192 426 Z\" fill=\"url(#bokChoyLeaf)\" />\n            <!-- Crisp pale-green stems -->\n            <path d=\"M 218 394 C 242 368, 268 358, 298 372 C 306 386, 292 406, 268 412 C 244 418, 224 410, 218 394 Z\" fill=\"url(#bokChoyStem)\" />\n            <path d=\"M 238 424 C 264 402, 292 398, 314 416 C 316 432, 294 446, 268 444 C 248 442, 236 434, 238 424 Z\" fill=\"url(#bokChoyStem)\" />\n          </g>\n\n          <!-- 3. Marinated Menma / Bamboo Shoots (upper-left) -->\n          <g class=\"topping-float-c\" filter=\"url(#softShadow)\">\n            <g transform=\"translate(278, 258) rotate(-24)\">\n              <rect x=\"0\" y=\"0\" width=\"68\" height=\"15\" rx=\"4\" fill=\"url(#menmaGrad)\" />\n              <line x1=\"8\" y1=\"5\" x2=\"58\" y2=\"5\" stroke=\"rgba(90, 42, 6, 0.35)\" stroke-width=\"1.2\" />\n              <line x1=\"12\" y1=\"10\" x2=\"62\" y2=\"10\" stroke=\"rgba(255, 220, 150, 0.25)\" stroke-width=\"1\" />\n            </g>\n            <g transform=\"translate(296, 278) rotate(-12)\">\n              <rect x=\"0\" y=\"0\" width=\"72\" height=\"14\" rx=\"4\" fill=\"url(#menmaGrad)\" />\n              <line x1=\"6\" y1=\"5\" x2=\"64\" y2=\"5\" stroke=\"rgba(90, 42, 6, 0.35)\" stroke-width=\"1.2\" />\n            </g>\n            <g transform=\"translate(268, 286) rotate(-32)\">\n              <rect x=\"0\" y=\"0\" width=\"60\" height=\"13\" rx=\"3.5\" fill=\"url(#menmaGrad)\" />\n            </g>\n          </g>\n\n          <!-- 4. Crispy Seared & Glazed Tofu Slices (upper-center-left) -->\n          <g class=\"topping-float-b\" filter=\"url(#softShadow)\">\n            <!-- Tofu slice 1 -->\n            <g transform=\"translate(362, 228) rotate(12)\">\n              <rect x=\"0\" y=\"0\" width=\"84\" height=\"54\" rx=\"8\" fill=\"url(#tofuCrust)\" />\n              <rect x=\"5\" y=\"5\" width=\"74\" height=\"44\" rx=\"5\" fill=\"url(#tofuBody)\" />\n              <!-- Caramelized sear marks -->\n              <path d=\"M 14 14 L 34 38 M 36 10 L 56 36 M 56 14 L 70 30\" stroke=\"#9e4713\" stroke-width=\"3.5\" stroke-linecap=\"round\" opacity=\"0.55\" />\n              <!-- Glaze highlight -->\n              <path d=\"M 12 10 Q 38 6, 66 12\" stroke=\"rgba(255, 245, 225, 0.65)\" stroke-width=\"2.5\" stroke-linecap=\"round\" fill=\"none\" />\n            </g>\n            <!-- Tofu slice 2 (overlapping) -->\n            <g transform=\"translate(402, 256) rotate(24)\">\n              <rect x=\"0\" y=\"0\" width=\"82\" height=\"52\" rx=\"8\" fill=\"url(#tofuCrust)\" />\n              <rect x=\"5\" y=\"5\" width=\"72\" height=\"42\" rx=\"5\" fill=\"url(#tofuBody)\" />\n              <path d=\"M 14 14 L 32 36 M 36 12 L 54 36 M 54 14 L 68 30\" stroke=\"#9e4713\" stroke-width=\"3.5\" stroke-linecap=\"round\" opacity=\"0.55\" />\n              <path d=\"M 14 10 Q 42 7, 64 12\" stroke=\"rgba(255, 245, 225, 0.65)\" stroke-width=\"2.5\" stroke-linecap=\"round\" fill=\"none\" />\n            </g>\n          </g>\n\n          <!-- 5. Star-Scored Charred Shiitake Mushrooms (right-center) -->\n          <g class=\"topping-float-a\" filter=\"url(#softShadow)\">\n            <!-- Shiitake 1 -->\n            <g transform=\"translate(506, 368) rotate(14)\">\n              <ellipse cx=\"0\" cy=\"0\" rx=\"40\" ry=\"33\" fill=\"url(#shiitakeCap)\" />\n              <!-- Decorative star-cut score revealing pale mushroom flesh -->\n              <path d=\"M -22 -4 L 22 4 M -4 -20 L 4 20 M -15 -14 L 15 14 M -14 15 L 14 -15\" stroke=\"#e8d2b2\" stroke-width=\"4.2\" stroke-linecap=\"round\" />\n              <path d=\"M -18 -2 L 18 2 M -2 -16 L 2 16\" stroke=\"#b58d60\" stroke-width=\"1.5\" stroke-linecap=\"round\" />\n              <!-- Glossy broth sheen -->\n              <ellipse cx=\"-14\" cy=\"-12\" rx=\"10\" ry=\"5\" fill=\"rgba(255, 220, 175, 0.22)\" transform=\"rotate(-25 -14 -12)\" />\n            </g>\n            <!-- Shiitake 2 -->\n            <g transform=\"translate(534, 428) rotate(-18)\">\n              <ellipse cx=\"0\" cy=\"0\" rx=\"34\" ry=\"28\" fill=\"url(#shiitakeCap)\" />\n              <path d=\"M -18 -3 L 18 3 M -3 -16 L 3 16 M -12 -11 L 12 11 M -11 12 L 11 -12\" stroke=\"#e8d2b2\" stroke-width=\"3.6\" stroke-linecap=\"round\" />\n              <ellipse cx=\"-11\" cy=\"-9\" rx=\"8\" ry=\"4\" fill=\"rgba(255, 220, 175, 0.2)\" transform=\"rotate(-20 -11 -9)\" />\n            </g>\n          </g>\n\n          <!-- 6. Sweet Roasted Corn Kernels (lower-right cluster) -->\n          <g class=\"topping-float-c\" filter=\"url(#softShadow)\">\n            <g fill=\"#f2bc38\" stroke=\"#c47f14\" stroke-width=\"0.8\">\n              <ellipse cx=\"474\" cy=\"496\" rx=\"8\" ry=\"6.5\" transform=\"rotate(15 474 496)\" />\n              <ellipse cx=\"490\" cy=\"488\" rx=\"8\" ry=\"6.5\" transform=\"rotate(-10 490 488)\" />\n              <ellipse cx=\"484\" cy=\"508\" rx=\"7.5\" ry=\"6\" transform=\"rotate(30 484 508)\" />\n              <ellipse cx=\"502\" cy=\"502\" rx=\"8\" ry=\"6.5\" transform=\"rotate(5 502 502)\" />\n              <ellipse cx=\"464\" cy=\"512\" rx=\"7.5\" ry=\"6\" transform=\"rotate(-22 464 512)\" />\n              <ellipse cx=\"496\" cy=\"518\" rx=\"7\" ry=\"5.5\" transform=\"rotate(18 496 518)\" />\n              <ellipse cx=\"514\" cy=\"488\" rx=\"7.5\" ry=\"6\" transform=\"rotate(42 514 488)\" />\n            </g>\n            <!-- Corn kernel specular highlights -->\n            <g fill=\"rgba(255, 250, 210, 0.65)\">\n              <circle cx=\"472\" cy=\"494\" r=\"2\" />\n              <circle cx=\"488\" cy=\"486\" r=\"2\" />\n              <circle cx=\"500\" cy=\"500\" r=\"2\" />\n              <circle cx=\"482\" cy=\"506\" r=\"1.8\" />\n            </g>\n          </g>\n\n          <!-- 7. Fresh Scallion Rings (Negi) & Fine Chili Threads (Ito-togarashi) -->\n          <g class=\"topping-float-b\" filter=\"url(#softShadow)\">\n            <!-- Scallion rings -->\n            <g fill=\"none\" stroke-width=\"4.2\">\n              <ellipse cx=\"378\" cy=\"368\" rx=\"11\" ry=\"8\" stroke=\"#68b849\" transform=\"rotate(12 378 368)\" />\n              <ellipse cx=\"378\" cy=\"368\" rx=\"7\" ry=\"4.5\" stroke=\"#d8f0c0\" stroke-width=\"2\" transform=\"rotate(12 378 368)\" />\n\n              <ellipse cx=\"404\" cy=\"354\" rx=\"10\" ry=\"7.5\" stroke=\"#53a337\" transform=\"rotate(-18 404 354)\" />\n              <ellipse cx=\"404\" cy=\"354\" rx=\"6\" ry=\"4\" stroke=\"#d8f0c0\" stroke-width=\"1.8\" transform=\"rotate(-18 404 354)\" />\n\n              <ellipse cx=\"394\" cy=\"388\" rx=\"11.5\" ry=\"8.5\" stroke=\"#75c754\" transform=\"rotate(28 394 388)\" />\n              <ellipse cx=\"394\" cy=\"388\" rx=\"7.5\" ry=\"4.8\" stroke=\"#e4f5d0\" stroke-width=\"2\" transform=\"rotate(28 394 388)\" />\n\n              <ellipse cx=\"354\" cy=\"386\" rx=\"9.5\" ry=\"7\" stroke=\"#53a337\" transform=\"rotate(-8 354 386)\" />\n              <ellipse cx=\"424\" cy=\"378\" rx=\"10\" ry=\"7.5\" stroke=\"#68b849\" transform=\"rotate(18 424 378)\" />\n              <ellipse cx=\"332\" cy=\"472\" rx=\"9.5\" ry=\"7\" stroke=\"#53a337\" transform=\"rotate(34 332 472)\" />\n              <ellipse cx=\"436\" cy=\"436\" rx=\"9\" ry=\"6.5\" stroke=\"#68b849\" transform=\"rotate(-24 436 436)\" />\n            </g>\n\n            <!-- Delicate crimson chili threads (Ito-togarashi) in center -->\n            <g stroke=\"#d92b18\" stroke-width=\"1.4\" stroke-linecap=\"round\" fill=\"none\" opacity=\"0.92\">\n              <path d=\"M 366 356 Q 388 338, 412 352\" />\n              <path d=\"M 372 364 Q 396 346, 422 362\" />\n              <path d=\"M 364 348 Q 392 362, 418 344\" />\n              <path d=\"M 378 342 Q 396 368, 408 378\" />\n              <path d=\"M 368 372 Q 394 356, 416 370\" />\n            </g>\n          </g>\n\n          <!-- 8. Toasted White & Black Sesame Seeds -->\n          <g opacity=\"0.9\">\n            <g fill=\"#f5e3ba\">\n              <ellipse cx=\"326\" cy=\"342\" rx=\"3\" ry=\"1.6\" transform=\"rotate(25 326 342)\" />\n              <ellipse cx=\"348\" cy=\"332\" rx=\"2.8\" ry=\"1.5\" transform=\"rotate(-40 348 332)\" />\n              <ellipse cx=\"456\" cy=\"348\" rx=\"3\" ry=\"1.6\" transform=\"rotate(62 456 348)\" />\n              <ellipse cx=\"468\" cy=\"366\" rx=\"2.8\" ry=\"1.5\" transform=\"rotate(-15 468 366)\" />\n              <ellipse cx=\"312\" cy=\"442\" rx=\"3\" ry=\"1.6\" transform=\"rotate(12 312 442)\" />\n              <ellipse cx=\"364\" cy=\"512\" rx=\"2.8\" ry=\"1.5\" transform=\"rotate(-55 364 512)\" />\n              <ellipse cx=\"416\" cy=\"522\" rx=\"3\" ry=\"1.6\" transform=\"rotate(38 416 522)\" />\n              <ellipse cx=\"298\" cy=\"378\" rx=\"2.8\" ry=\"1.5\" transform=\"rotate(-22 298 378)\" />\n            </g>\n            <g fill=\"#1c1613\">\n              <ellipse cx=\"338\" cy=\"348\" rx=\"2.8\" ry=\"1.5\" transform=\"rotate(-18 338 348)\" />\n              <ellipse cx=\"442\" cy=\"356\" rx=\"2.8\" ry=\"1.5\" transform=\"rotate(44 442 356)\" />\n              <ellipse cx=\"384\" cy=\"414\" rx=\"2.8\" ry=\"1.5\" transform=\"rotate(-30 384 414)\" />\n              <ellipse cx=\"452\" cy=\"408\" rx=\"2.6\" ry=\"1.4\" transform=\"rotate(15 452 408)\" />\n              <ellipse cx=\"344\" cy=\"496\" rx=\"2.8\" ry=\"1.5\" transform=\"rotate(52 344 496)\" />\n              <ellipse cx=\"396\" cy=\"532\" rx=\"2.6\" ry=\"1.4\" transform=\"rotate(-12 396 532)\" />\n            </g>\n          </g>\n\n          <!-- Inner bowl rim shadow vignette over broth -->\n          <rect x=\"140\" y=\"150\" width=\"520\" height=\"500\" fill=\"url(#brothRimDepth)\" pointer-events=\"none\" />\n        </g>\n\n        <!-- Artisanal rim glaze subtle speckle overlay -->\n        <ellipse cx=\"400\" cy=\"392\" rx=\"268\" ry=\"246\" fill=\"none\" stroke=\"rgba(210, 128, 68, 0.14)\" stroke-width=\"6\" />\n\n        <!-- Sleek Dark-Walnut Chopsticks (Hashi) resting naturally across the upper-right rim -->\n        <g filter=\"url(#softShadow)\">\n          <!-- Chopstick 1 -->\n          <polygon points=\"482,118 492,114 688,434 683,437\" fill=\"url(#chopstickGrad)\" />\n          <line x1=\"485\" y1=\"117\" x2=\"685\" y2=\"435\" stroke=\"rgba(255, 200, 150, 0.18)\" stroke-width=\"1.2\" />\n          <!-- Chopstick 2 -->\n          <polygon points=\"504,108 514,104 714,418 709,421\" fill=\"url(#chopstickGrad)\" />\n          <line x1=\"507\" y1=\"107\" x2=\"711\" y2=\"419\" stroke=\"rgba(255, 200, 150, 0.16)\" stroke-width=\"1.2\" />\n        </g>\n      </svg>\n\n      <!-- Steam + Broth Ripple Canvas -->\n      <canvas id=\"steam-canvas\"></canvas>\n    </div>\n  </main>\n\n  <script>\n    (() => {\n      const scene = document.getElementById('scene');\n      const bowlStage = document.getElementById('bowl-stage');\n      const steamCanvas = document.getElementById('steam-canvas');\n      const ambientCanvas = document.getElementById('ambient-canvas');\n      const sCtx = steamCanvas.getContext('2d');\n      const aCtx = ambientCanvas.getContext('2d');\n\n      const reducedMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');\n      let prefersReducedMotion = reducedMotionQuery.matches;\n\n      // Mouse & interaction state\n      const pointer = {\n        x: 0.5,\n        y: 0.5,\n        targetX: 0.5,\n        targetY: 0.5,\n        vx: 0,\n        vy: 0,\n        lastClientX: null,\n        lastClientY: null,\n        active: false\n      };\n\n      // Broth ripple state\n      const ripples = [];\n      let lastRippleTime = 0;\n\n      // Steam particles\n      const steamPuffs = [];\n      const MAX_STEAM = 44;\n\n      // Ambient warm dust/ember motes\n      const motes = [];\n      const MAX_MOTES = 28;\n\n      function resizeCanvases() {\n        const dpr = Math.min(window.devicePixelRatio || 1, 2);\n\n        const sRect = bowlStage.getBoundingClientRect();\n        steamCanvas.width = Math.max(1, Math.floor(sRect.width * dpr));\n        steamCanvas.height = Math.max(1, Math.floor(sRect.height * dpr));\n        sCtx.setTransform(dpr, 0, 0, dpr, 0, 0);\n\n        const aRect = scene.getBoundingClientRect();\n        ambientCanvas.width = Math.max(1, Math.floor(aRect.width * dpr));\n        ambientCanvas.height = Math.max(1, Math.floor(aRect.height * dpr));\n        aCtx.setTransform(dpr, 0, 0, dpr, 0, 0);\n      }\n\n      function createSteamPuff(initialProgress = 0) {\n        const w = steamCanvas.clientWidth || 600;\n        const h = steamCanvas.clientHeight || 600;\n        // Originates from the hot broth surface (centered ~ 50% width, 49% height)\n        const angle = Math.random() * Math.PI * 2;\n        const radius = Math.sqrt(Math.random()) * w * 0.22;\n        const startX = w * 0.5 + Math.cos(angle) * radius;\n        const startY = h * 0.49 + Math.sin(angle) * radius * 0.78;\n\n        const life = 1;\n        const maxLife = 3.6 + Math.random() * 2.8;\n        const age = initialProgress * maxLife;\n\n        return {\n          x: startX,\n          y: startY - initialProgress * h * 0.34,\n          vx: (Math.random() - 0.5) * 6,\n          vy: -(22 + Math.random() * 18),\n          baseRadius: w * (0.045 + Math.random() * 0.055),\n          age,\n          maxLife,\n          life,\n          wobbleFreq: 0.8 + Math.random() * 1.1,\n          wobblePhase: Math.random() * Math.PI * 2,\n          wobbleAmp: 10 + Math.random() * 16,\n          alphaMax: 0.085 + Math.random() * 0.065\n        };\n      }\n\n      function createMote() {\n        const w = ambientCanvas.clientWidth || window.innerWidth;\n        const h = ambientCanvas.clientHeight || window.innerHeight;\n        return {\n          x: Math.random() * w,\n          y: Math.random() * h,\n          r: 0.8 + Math.random() * 2.1,\n          vx: (Math.random() - 0.5) * 8,\n          vy: -(4 + Math.random() * 10),\n          phase: Math.random() * Math.PI * 2,\n          alpha: 0.08 + Math.random() * 0.22\n        };\n      }\n\n      function initParticles() {\n        steamPuffs.length = 0;\n        for (let i = 0; i < MAX_STEAM; i++) {\n          steamPuffs.push(createSteamPuff(i / MAX_STEAM));\n        }\n        motes.length = 0;\n        for (let i = 0; i < MAX_MOTES; i++) {\n          motes.push(createMote());\n        }\n      }\n\n      function spawnRipple(normX, normY) {\n        const now = performance.now();\n        if (now - lastRippleTime < 140) return;\n        lastRippleTime = now;\n        const w = steamCanvas.clientWidth || 600;\n        const h = steamCanvas.clientHeight || 600;\n        ripples.push({\n          x: normX * w,\n          y: normY * h,\n          r: 4,\n          maxR: w * (0.06 + Math.random() * 0.05),\n          alpha: 0.32\n        });\n      }\n\n      function handlePointerMove(clientX, clientY) {\n        if (prefersReducedMotion) return;\n\n        const w = window.innerWidth || 1;\n        const h = window.innerHeight || 1;\n        pointer.targetX = clientX / w;\n        pointer.targetY = clientY / h;\n        pointer.active = true;\n\n        if (pointer.lastClientX !== null) {\n          pointer.vx = Math.max(-45, Math.min(45, clientX - pointer.lastClientX));\n          pointer.vy = Math.max(-45, Math.min(45, clientY - pointer.lastClientY));\n        }\n        pointer.lastClientX = clientX;\n        pointer.lastClientY = clientY;\n\n        // Check if pointer is over the broth area to trigger subtle ripples\n        const rect = bowlStage.getBoundingClientRect();\n        const bx = (clientX - rect.left) / rect.width;\n        const by = (clientY - rect.top) / rect.height;\n        const dx = (bx - 0.5) / 0.30;\n        const dy = (by - 0.49) / 0.27;\n        if (dx * dx + dy * dy < 1) {\n          spawnRipple(bx, by);\n        }\n      }\n\n      window.addEventListener('pointermove', (e) => {\n        handlePointerMove(e.clientX, e.clientY);\n      }, { passive: true });\n\n      window.addEventListener('pointerleave', () => {\n        pointer.targetX = 0.5;\n        pointer.targetY = 0.5;\n        pointer.vx = 0;\n        pointer.vy = 0;\n        pointer.lastClientX = null;\n        pointer.lastClientY = null;\n        pointer.active = false;\n      });\n\n      function renderStaticScene() {\n        const sw = steamCanvas.clientWidth || 600;\n        const sh = steamCanvas.clientHeight || 600;\n        sCtx.clearRect(0, 0, sw, sh);\n\n        // Draw serene static steam wisps\n        for (const p of steamPuffs) {\n          const progress = p.age / p.maxLife;\n          const fadeIn = Math.min(1, progress * 3.5);\n          const fadeOut = Math.pow(Math.max(0, 1 - progress), 1.4);\n          const alpha = p.alphaMax * fadeIn * fadeOut;\n          if (alpha <= 0.002) continue;\n\n          const radius = p.baseRadius * (0.7 + progress * 1.85);\n          const grad = sCtx.createRadialGradient(p.x, p.y, 0, p.x, p.y, radius);\n          grad.addColorStop(0, `rgba(255, 240, 224, ${alpha.toFixed(3)})`);\n          grad.addColorStop(0.55, `rgba(248, 222, 196, ${(alpha * 0.42).toFixed(3)})`);\n          grad.addColorStop(1, 'rgba(240, 210, 180, 0)');\n          sCtx.fillStyle = grad;\n          sCtx.beginPath();\n          sCtx.arc(p.x, p.y, radius, 0, Math.PI * 2);\n          sCtx.fill();\n        }\n\n        const aw = ambientCanvas.clientWidth || window.innerWidth;\n        const ah = ambientCanvas.clientHeight || window.innerHeight;\n        aCtx.clearRect(0, 0, aw, ah);\n        for (const m of motes) {\n          aCtx.fillStyle = `rgba(255, 198, 130, ${m.alpha.toFixed(3)})`;\n          aCtx.beginPath();\n          aCtx.arc(m.x, m.y, m.r, 0, Math.PI * 2);\n          aCtx.fill();\n        }\n      }\n\n      let lastTime = performance.now();\n      let rafId = null;\n\n      function animate(now) {\n        const dt = Math.min(0.05, (now - lastTime) / 1000);\n        lastTime = now;\n\n        // Smooth pointer interpolation\n        pointer.x += (pointer.targetX - pointer.x) * 0.065;\n        pointer.y += (pointer.targetY - pointer.y) * 0.065;\n        pointer.vx *= 0.9;\n        pointer.vy *= 0.9;\n\n        const offsetX = pointer.x - 0.5;\n        const offsetY = pointer.y - 0.5;\n\n        // Subtle 3D parallax & ambient light response\n        scene.style.setProperty('--bg-x', `${(-offsetX * 14).toFixed(2)}px`);\n        scene.style.setProperty('--bg-y', `${(-offsetY * 14).toFixed(2)}px`);\n        scene.style.setProperty('--glow-x', `${(offsetX * 42).toFixed(2)}px`);\n        scene.style.setProperty('--glow-y', `${(offsetY * 42).toFixed(2)}px`);\n        scene.style.setProperty('--bowl-x', `${(offsetX * 10).toFixed(2)}px`);\n        scene.style.setProperty('--bowl-y', `${(offsetY * 10).toFixed(2)}px`);\n        scene.style.setProperty('--tilt-x', `${(-offsetY * 3.2).toFixed(2)}deg`);\n        scene.style.setProperty('--tilt-y', `${(offsetX * 3.2).toFixed(2)}deg`);\n\n        // Render ambient warm motes\n        const aw = ambientCanvas.clientWidth || window.innerWidth;\n        const ah = ambientCanvas.clientHeight || window.innerHeight;\n        aCtx.clearRect(0, 0, aw, ah);\n\n        for (const m of motes) {\n          m.x += m.vx * dt + Math.sin(now * 0.0007 + m.phase) * 0.15;\n          m.y += m.vy * dt;\n          if (m.y < -10) {\n            m.y = ah + 10;\n            m.x = Math.random() * aw;\n          }\n          if (m.x < -10) m.x = aw + 10;\n          if (m.x > aw + 10) m.x = -10;\n\n          const twinkle = 0.65 + 0.35 * Math.sin(now * 0.0018 + m.phase);\n          aCtx.fillStyle = `rgba(255, 192, 122, ${(m.alpha * twinkle).toFixed(3)})`;\n          aCtx.beginPath();\n          aCtx.arc(m.x, m.y, m.r, 0, Math.PI * 2);\n          aCtx.fill();\n        }\n\n        // Render broth ripples & volumetric steam\n        const sw = steamCanvas.clientWidth || 600;\n        const sh = steamCanvas.clientHeight || 600;\n        sCtx.clearRect(0, 0, sw, sh);\n\n        // Broth ripples\n        for (let i = ripples.length - 1; i >= 0; i--) {\n          const rp = ripples[i];\n          rp.r += dt * 42;\n          rp.alpha -= dt * 0.35;\n          if (rp.alpha <= 0 || rp.r >= rp.maxR) {\n            ripples.splice(i, 1);\n            continue;\n          }\n          sCtx.strokeStyle = `rgba(255, 224, 175, ${rp.alpha.toFixed(3)})`;\n          sCtx.lineWidth = 1.4;\n          sCtx.beginPath();\n          sCtx.ellipse(rp.x, rp.y, rp.r, rp.r * 0.85, 0, 0, Math.PI * 2);\n          sCtx.stroke();\n        }\n\n        // Pointer position in steamCanvas coordinates for steam dispersion\n        const rect = bowlStage.getBoundingClientRect();\n        const px = pointer.lastClientX !== null ? pointer.lastClientX - rect.left : -9999;\n        const py = pointer.lastClientY !== null ? pointer.lastClientY - rect.top : -9999;\n\n        for (let i = 0; i < steamPuffs.length; i++) {\n          const p = steamPuffs[i];\n          p.age += dt;\n          if (p.age >= p.maxLife) {\n            steamPuffs[i] = createSteamPuff(0);\n            continue;\n          }\n\n          const progress = p.age / p.maxLife;\n          // Organic rising curl\n          const curl = Math.sin(p.age * p.wobbleFreq + p.wobblePhase) * p.wobbleAmp * dt;\n          p.x += p.vx * dt + curl;\n          p.y += p.vy * dt;\n\n          // Interactive cursor disturbance: push/swirl steam near pointer\n          if (pointer.active) {\n            const dx = p.x - px;\n            const dy = p.y - py;\n            const distSq = dx * dx + dy * dy;\n            const influenceR = sw * 0.16;\n            if (distSq < influenceR * influenceR && distSq > 1) {\n              const dist = Math.sqrt(distSq);\n              const force = (1 - dist / influenceR) * 120 * dt;\n              p.x += (dx / dist) * force + pointer.vx * 0.28 * 